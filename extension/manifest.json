{
  "manifest_version": 3,
  "name": "Duytai Integration Module (64-Bit)",
  "version": "7.5.0",
  "key": "",
  "description": "Tự động bắt trước mọi định dạng tệp tải xuống & Video (64/128 luồng) chuyển về Duytai tại 127.0.0.1:17890 — không hiện Đã hủy trên trình duyệt.",
  "minimum_chrome_version": "102",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "notifications", "nativeMessaging"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:17890/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "duytai-idm@doanduy.dev",
      "strict_min_version": "109.0"
    }
  },
  "action": { "default_title": "Duytai 64-Bit", "default_popup": "popup.html" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
