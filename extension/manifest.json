{
  "manifest_version": 3,
  "name": "Duytai Integration Module (64-Bit)",
  "version": "7.0.0",
  "description": "Tự động bắt mọi định dạng tệp tải xuống & Video (64/128 luồng) chuyển về Duytai tại 127.0.0.1:17890.",
  "minimum_chrome_version": "102",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "notifications"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:17890/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Duytai 64-Bit", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
